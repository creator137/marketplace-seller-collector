DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=*

# Postgres/Redis (в docker-compose подставляются автоматически)
DATABASE_URL=postgresql://seller:seller@localhost:5432/seller
REDIS_URL=redis://localhost:6379/0
# Синхронный режим очереди (без Redis) — только для локальной разработки
RQ_ASYNC=1

# Enrichment
DADATA_TOKEN=
DADATA_SECRET=

# Cookies для маркетплейсов (строка Cookie-заголовка или JSON-словарь)
OZON_COOKIES=
WB_COOKIES=
YANDEX_MARKET_COOKIES=

HTTP_TIMEOUT=30
HTTP_RETRIES=3
HTTP_RATE_DELAY=1.0
HTTP_PROXY=
HTTPS_PROXY=
RQ_DEFAULT_TIMEOUT=43200
COLLECT_MAX_SELLERS=0
COLLECT_CONCURRENCY=3
COLLECT_DETAIL_CHUNK=100
COLLECT_PROGRESS_BATCH=25
DADATA_TTL_DAYS=30

# Recurring collection (scheduler service). Target is per marketplace/job,
# across every active category and city. Blocked jobs wait for a new session.
AUTO_COLLECT_TARGET=5000
AUTO_COLLECT_INTERVAL=86400
AUTO_COLLECT_POLL=60
AUTO_COLLECT_USERNAME=admin
