DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=*

# Postgres/Redis (в docker-compose подставляются автоматически)
DATABASE_URL=postgresql://seller:seller@localhost:5432/seller
REDIS_URL=redis://localhost:6379/0
# Синхронный режим очереди (без Redis) — только для локальной разработки
RQ_ASYNC=1

# Enrichment
DADATA_TOKEN=
DADATA_SECRET=

# Cookies для маркетплейсов (строка Cookie-заголовка или JSON-словарь)
OZON_COOKIES=
WB_COOKIES=
YANDEX_MARKET_COOKIES=

HTTP_TIMEOUT=30
HTTP_RETRIES=3
HTTP_RATE_DELAY=1.0
DADATA_TTL_DAYS=30
